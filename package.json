  "license": "MIT",
  "author": "bangjier",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bangjier/lanhu-flow.git"
  },
  "homepage": "https://github.com/bangjier/lanhu-flow#readme",
  "bugs": {
    "url": "https://github.com/bangjier/lanhu-flow/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "lanhuflow",
    "lanhu",
    "蓝湖",
    "design",
    "design-to-code",
    "figma-alternative",
